{
  "productName": "FFmpeg Studio",
  "version": "0.3.0",
  "identifier": "com.ffmpeg-studio.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FFmpeg Studio",
        "width": 1229,
        "height": 768,
        "minWidth": 1229,
        "minHeight": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/ffmpeg/bin/ffmpeg.exe": "bin/ffmpeg.exe",
      "../resources/ffmpeg/bin/ffprobe.exe": "bin/ffprobe.exe"
    }
  }
}